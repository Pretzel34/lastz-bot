{
  "name": "fp_reward_collection",
  "actions": [
    {
      "action": "ensure_hq_view",
      "hq_btn": "btn_go_world.png",
      "world_btn": "btn_go_headquarters.png",
      "note": "Guarantee HQ view before entering the event center — mod_vehicle_rally.json/other FP tasks may leave the game in world view"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_event_center.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "scroll_left",
      "steps": 1,
      "distance_pct": 85,
      "start_x_pct": 20.0,
      "start_y_pct": 92.0,
      "note": "FP icon is the furthest icon to the left in the tab bar — scroll left to reveal it"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "tap_template_or_template",
      "template": "btn_full_prepardness_icon_primary.png",
      "fallback_templates": ["btn_full_prepardness_icon.png", "btn_full_prepardness_icon_secondary.png"],
      "required": true,
      "note": "Must find FP icon — error out if still not visible after scrolling left"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "check_template_present",
      "template": "btn_first_fp_chest_collected.png",
      "set_flag": "fp_chest1_already_collected",
      "note": "Read-only — does NOT tap. Records whether chest 1 was already collected on a PRIOR pass/day, not just this one."
    },
    {
      "action": "check_template_present",
      "template": "btn_second_fp_chest_collected.png",
      "set_flag": "fp_chest2_already_collected"
    },
    {
      "action": "check_template_present",
      "template": "btn_thrid_fp_chest_collected.png",
      "set_flag": "fp_chest3_already_collected"
    },
    {
      "action": "skip_to_if_flag",
      "flag": "fp_chest3_already_collected",
      "skip_to": 25,
      "note": "All 3 numbered chests already collected — nothing left to claim there, skip straight to the medal chest steps instead of wasting time re-attempting claims that can't succeed"
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_claim_first.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_congradulations.png",
      "required": false,
      "set_flag": "fp_chest1_claimed",
      "note": "Chest 1 of 3 — flag records whether a NEW claim was confirmed this pass"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_claim_second.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_congradulations.png",
      "required": false,
      "set_flag": "fp_chest2_claimed",
      "note": "Chest 2 of 3 — flag records whether a NEW claim was confirmed this pass"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "loop_until_template",
      "any_of": ["btn_fp_congradulations.png"],
      "max_iterations": 3,
      "on_each": [
        {
          "action": "if_template_tap",
          "template": "btn_fp_claim_third.png",
          "fallback_template": "btn_fp_claim_thrid_alt.png",
          "required": false
        },
        {
          "action": "wait",
          "seconds": 4.0
        }
      ],
      "note": "Chest 3 can take a beat to register as claimable — retry the tap instead of giving up after one miss, same pattern hero_progression.json uses"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_congradulations.png",
      "required": false,
      "set_flag": "fp_chest3_claimed",
      "note": "Chest 3 of 3 — flag records whether a NEW claim was confirmed this pass"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_claim_medal_chest_first.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_fp_congradulations.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "tap_first_found",
      "templates": [
        "btn_back.png",
        "btn_back_out_of_page.png",
        "btn_press_back.png",
        "btn_hero_back.png"
      ],
      "required": false,
      "log_skip": "No back button found — could not back out of the FP event view",
      "note": "Back out to HQ after claiming everything above — otherwise the game is left sitting on the FP/event-center screen. Safe to add here even for callers that run this task twice in a row (e.g. shelter_upgrade.json retrying chest 3) since this task always re-enters from ensure_hq_view at the top."
    }
  ]
}
