{
  "name": "start_rally_on_boomer",
  "actions": [
    {
      "action": "rally_count_check",
      "note": "Abort if daily rally limit already reached"
    },
    {
      "action": "ensure_hq_view",
      "hq_btn": "btn_go_world.png",
      "world_btn": "btn_go_headquarters.png",
      "note": "Guarantee a known starting state \u00e2\u20ac\u201d returns to HQ if in world, no-ops if already in HQ"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_go_world.png",
      "required": false,
      "note": "Navigate from HQ to world view \u00e2\u20ac\u201d skip if already in world"
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_rally_reward_chest.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "tap_template_or_template",
      "template": "btn_claim_all_generic.png",
      "fallback_template": "btn_close.png",
      "required": false
    },
    {
      "action": "wait",
      "seconds": 4.0
    },
    {
      "action": "check_formations_busy",
      "slots": [
        {
          "x_pct": 92.6,
          "y_pct": 51.0
        },
        {
          "x_pct": 92.8,
          "y_pct": 56.9
        },
        {
          "x_pct": 92.6,
          "y_pct": 62.5
        },
        {
          "x_pct": 92.8,
          "y_pct": 68.0
        }
      ],
      "locked_template": "btn_fourth_formation_locked.png",
      "note": "Abort early if all formation slots are already occupied \u00e2\u20ac\u201d no point searching for a boomer"
    },
    {
      "action": "tap_template_or_zone",
      "template": "btn_search_lens_icon.png",
      "x_pct": 5.2,
      "y_pct": 80.7,
      "required": false
    },
    {
      "action": "wait",
      "seconds": 6.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_boomer.png",
      "fallback_templates": [
        "btn_frostbane_boomer.png",
        "btn_stegosaurus_boomer.png"
      ],
      "skip_task_if_not_found": true,
      "log_skip": "Boomer search panel not found \u00e2\u20ac\u201d wrong screen, cancelling task",
      "note": "Select Boomer category. If neither template is visible the search panel didn't open \u00e2\u20ac\u201d abort rather than continue on the wrong screen."
    },
    {
      "action": "wait",
      "seconds": 3.0
    },
    {
      "action": "adjust_boomer_level",
      "setting": "rally.boomer_level",
      "template_pattern": "btn_lvl_{value}_boomer.png",
      "plus_template": "btn_plus_boomer.png",
      "minus_template": "btn_subtract_boomer_lvl.png",
      "min_level": 1,
      "max_level": 60,
      "max_attempts": 50,
      "tap_delay": 3.0,
      "required": false,
      "note": "Detect current boomer level and tap +/- until it matches rally.boomer_level setting"
    },
    {
      "action": "wait",
      "seconds": 2.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_search_boomer.png",
      "fallback_template": "btn_generic_search.png",
      "required": false,
      "note": "Search with the correct level now set"
    },
    {
      "action": "wait",
      "seconds": 6.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_team_up_boomer.png",
      "fallback_template": "btn_team_up_boomer_alt.png",
      "required": true
    },
    {
      "action": "wait",
      "seconds": 6.0
    },
    {
      "action": "if_template_tap",
      "template": "btn_march_on_boomer.png",
      "fallback_template": "btn_march_on_boomer_alt.png",
      "fuel_template": "btn_out_of_fuel.png",
      "required": false,
      "log_skip": "Troops busy \u00e2\u20ac\u201d march not available, skipping rally attempt",
      "on_not_found": [
        {
          "action": "if_template_tap",
          "template": "btn_back_out_of_page.png",
          "required": false
        },
        {
          "action": "wait",
          "seconds": 2.0
        },
        {
          "action": "if_template_tap",
          "template": "btn_back_out_of_page.png",
          "required": false
        },
        {
          "action": "wait",
          "seconds": 2.0
        }
      ],
      "note": "If out of fuel, restore_fuel runs automatically and retries. If march still absent, troops are busy \u00e2\u20ac\u201d close panel and abort."
    },
    {
      "action": "rally_count_record",
      "note": "Only reached when march was successfully tapped \u00e2\u20ac\u201d record the rally now"
    },
    {
      "action": "wait",
      "seconds": 6.0
    }
  ]
}